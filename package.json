{
  "name": "dgtlface-panel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "check:runtime": "node scripts/check-node.cjs",
    "preinstall": "npm run check:runtime",
    "predev": "npm run check:runtime",
    "prebuild": "npm run check:runtime",
    "prestart": "npm run check:runtime",
    "preworker": "npm run check:runtime",
    "dev": "node scripts/dev.cjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "import:checklist": "node --env-file-if-exists=.env.local --import tsx scripts/import-checklist.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node tests/http-smoke.mjs",
    "owner:prepare": "node --import tsx scripts/prepare-owner.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "iron-session": "9.0.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
