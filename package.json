    "test:integration": "node tests/http-smoke.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "iron-session": "9.0.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "pg": "^8.16.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.23.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
