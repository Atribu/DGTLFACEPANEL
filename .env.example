# Local development: leave DATABASE_URL empty for persistent .data/postgres.
# Never commit .env.local, .data or a production database backup.
DATABASE_URL=
# Required for production: generate at least 32 random characters.
SESSION_SECRET=
# Separate random key of at least 32 characters for scheduled work; required in production.
JOBS_SECRET=
# Worker-to-app origin. Keep loopback for a worker on the same server.
MAINTENANCE_ORIGIN=http://127.0.0.1:3000
# Optional canonical browser origin behind a reverse proxy, e.g. https://panel.example.com
APP_ORIGIN=
# Never enable for production. Local PGlite automatically provides demo accounts.
ENABLE_DEMO=false
# Production account provisioning (loads DATABASE_URL and SESSION_SECRET):
# NODE_ENV=production node --env-file=.env.local --import tsx scripts/create-admin.ts
# ADMIN_EMAIL=your-email@example.com
# ADMIN_NAME=Your Name
# ADMIN_PASSWORD=unique-password-at-least-12-characters
